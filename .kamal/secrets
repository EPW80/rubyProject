# Secrets referenced from config/deploy.yml (registry/password and env/secret).
# All secrets are pulled from ENV or a secrets manager — DO NOT commit raw values here.
# This file is safe for git as long as it only references, never embeds, secrets.

# Image registry access token.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Rails production secret (no credentials/master.key in this app — read from ENV).
SECRET_KEY_BASE=$SECRET_KEY_BASE

# Application runtime secrets.
DATABASE_URL=$DATABASE_URL
JWT_SECRET_KEY=$JWT_SECRET_KEY

# Comma-separated list of allowed CORS origins (see config/initializers/cors.rb).
ALLOWED_ORIGINS=$ALLOWED_ORIGINS
