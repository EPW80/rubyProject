DATABASE_URL=postgresql://studioflow:password@db/studioflow_development
DATABASE_TEST_URL=postgresql://studioflow:password@db/studioflow_test
JWT_SECRET_KEY=replace_with_a_long_random_secret
RAILS_ENV=development

# Comma-separated list of origins allowed to make cross-origin (browser) requests.
# Leave empty to disallow all cross-origin requests (secure default).
# Example: ALLOWED_ORIGINS=https://app.studioflow.com,https://admin.studioflow.com
ALLOWED_ORIGINS=

# Required in production (no Rails credentials/master.key in this app).
# Generate with: bin/rails secret
SECRET_KEY_BASE=replace_with_a_long_random_secret
